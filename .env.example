# ===========================================
# CentaurOS Environment Configuration
# ===========================================
# Copy this file to .env.local and fill in your values

# ===========================================
# Supabase Configuration
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================================
# Stripe Configuration (use test keys for development)
# ===========================================
# Get your test keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook secret for local development
# Run `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# to get your webhook signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ===========================================
# OpenAI Configuration
# ===========================================
# Required for AI features (voice-to-task, marketplace search, etc.)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ===========================================
# App Configuration
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Domain Configuration (for production)
# Single domain architecture: marketing + app on same domain
NEXT_PUBLIC_MARKETING_DOMAIN=https://fractionalforge.app
NEXT_PUBLIC_APP_DOMAIN=https://fractionalforge.app

# ===========================================
# Google Workspace Integration (Calendar, Drive, Meet)
# ===========================================
# Required for Google Calendar sync, Drive file picker, and Meet links.
#
# How to get these:
# 1. Go to https://console.cloud.google.com/projectcreate and create a project
# 2. Enable "Google Calendar API" and "Google Drive API" in the API Library
# 3. Go to Credentials > Create Credentials > OAuth client ID > Web application
# 4. Add authorized redirect URI: https://your-domain.com/api/google/callback
# 5. Copy the Client ID and Client Secret below
#
# For local dev, add redirect URI: http://localhost:3000/api/google/callback
# Don't forget to configure the OAuth consent screen and add test users.

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret

# Secret for verifying Google Calendar push notification webhooks.
# Generate any random string: openssl rand -hex 32
GOOGLE_CALENDAR_WEBHOOK_SECRET=your-random-webhook-secret

# ===========================================
# Email (Resend) Configuration (optional)
# ===========================================
# Required for sending email notifications and transactional emails.
# Sign up at https://resend.com and create an API key.
#
# For development, Resend sends to your own email from onboarding@resend.dev.
# For production, verify your sending domain in the Resend dashboard.

RESEND_API_KEY=re_your-api-key
EMAIL_FROM_ADDRESS=ForgeOS <noreply@yourdomain.com>

# Secret for verifying inbound email webhooks from Resend.
# Generate any random string: openssl rand -hex 32
EMAIL_INBOUND_WEBHOOK_SECRET=your-random-webhook-secret

# ===========================================
# Telegram Bot Configuration
# ===========================================
# Create a bot with @BotFather on Telegram
# 1. Start chat with @BotFather
# 2. Send /newbot and follow instructions
# 3. Copy the token provided

TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_BOT_USERNAME=YourBotName  # Without @ symbol
TELEGRAM_WEBHOOK_SECRET=your-random-secret  # Optional, for webhook verification

# Set webhook URL (run once after deployment):
# curl -X POST "https://api.telegram.org/bot<YOUR_TOKEN>/setWebhook?url=https://your-domain.com/api/bot/telegram&secret_token=<YOUR_WEBHOOK_SECRET>"

# ===========================================
# Cron Jobs
# ===========================================
CRON_SECRET=your-random-cron-secret  # Protects cron endpoints from unauthorized access

# ===========================================
# Push Notifications (optional)
# ===========================================
# VAPID keys for web push notifications
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com

# ===========================================
# Testing Configuration (optional)
# ===========================================
# Set to 'true' to enable test mode features
TEST_MODE=false

# Test user credentials (used by seed scripts)
TEST_USER_PASSWORD=password123

# E2E test credentials (used by Playwright QA walkthroughs)
# Create test accounts in Supabase for each persona
TEST_FOUNDER_EMAIL=
TEST_FOUNDER_PASSWORD=
TEST_EXECUTIVE_EMAIL=
TEST_EXECUTIVE_PASSWORD=
TEST_APPRENTICE_EMAIL=
TEST_APPRENTICE_PASSWORD=
TEST_SUPPLIER_EMAIL=
TEST_SUPPLIER_PASSWORD=

# Optional: override base URL for E2E tests (defaults to http://localhost:3000)
# TEST_URL=https://your-staging-url.vercel.app
