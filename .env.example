# ===========================================
# ForgeOS Environment Configuration
# ===========================================
# Copy this file to .env.local and fill in your values

# ===========================================
# Supabase Configuration
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Must be the JWT-format key (starts with eyJ...) from Project Settings → API.
# Legacy-format keys are disabled and cause "Legacy API keys are disabled" errors.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================================
# Stripe Configuration (use test keys for development)
# ===========================================
# Get your test keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook secret for local development
# Run `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# to get your webhook signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ===========================================
# OpenAI Configuration
# ===========================================
# Required for AI features (voice-to-task, marketplace search, etc.)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ===========================================
# Google AI (Gemini) Configuration
# ===========================================
# Required for Product X-Ray blueprint image generation
# Get your API key from: https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=AIzaSy...

# ===========================================
# Anthropic Configuration
# ===========================================
# Required for The Forge 3D model generation (structural briefs + CadQuery code)
# Get your API key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ===========================================
# Together AI Configuration
# ===========================================
# Qwen 3.5 (397B-A17B) — decomposition fallback chain via Together AI
# Get your API key from: https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=

# ===========================================
# Qwen / DashScope Configuration (Alibaba Cloud)
# ===========================================
# Qwen3.5-plus — open-source frontier MoE (397B params, 17B active)
# Rivals GPT-5.2 at a fraction of the cost. Apache 2.0 licensed. 201 languages.
# Get your API key from: https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=sk-...

# ===========================================
# Qwen Local / Ollama Configuration (self-hosted)
# ===========================================
# Run Qwen3 models locally on your Mac Studio for zero-cost inference.
# Install Ollama: https://ollama.com
# Pull a model: ollama pull qwen3:30b-a3b
# Start server:  ./start-ollama.sh
#
# If Ollama runs on a different host (e.g., ngrok tunnel), set the URL below.
# Default: http://localhost:11434/v1
OLLAMA_BASE_URL=http://localhost:11434/v1

# ===========================================
# MiniMax Configuration
# ===========================================
# Powers specialist conversations (M2.5 — frontier quality at 1/100th Anthropic cost)
# Get your API key from: https://platform.minimax.io/user-center/basic-information/interface-key
MINIMAX_API_KEY=eyJhbGci...

# ===========================================
# PersonaPlex (NVIDIA Voice) Configuration
# ===========================================
# Powers full-duplex voice conversations with specialist agents.
# NVIDIA PersonaPlex: real-time speech-to-speech with 170ms latency.
# Sign up for API access at: https://personaplex.io
PERSONAPLEX_API_KEY=

# ===========================================
# Modal (CadQuery 3D Execution) Configuration
# ===========================================
# Single unified CAD API (one web endpoint). Paths /generate, /analyze, /mashup,
# /grammar, /convert-step, /batch-convert-step are appended by the app.
# Deploy: modal deploy modal_cad_worker.py
# Then set this to the deployed URL (e.g. ...--forgeos-cad-cad-web.modal.run)
MODAL_CAD_ENDPOINT_URL=https://your-workspace--forgeos-cad-cad-web.modal.run
# Obsolete (unified API uses one URL + path): MODAL_CAD_MASHUP_ENDPOINT_URL, MODAL_CAD_GRAMMAR_ENDPOINT_URL, MODAL_CAD_ANALYSIS_ENDPOINT_URL — remove from env if set.

# ===========================================
# App Configuration
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Domain Configuration (for production)
# Single domain architecture: marketing + app on same domain
NEXT_PUBLIC_MARKETING_DOMAIN=https://fractionalforge.app
NEXT_PUBLIC_APP_DOMAIN=https://fractionalforge.app

# ===========================================
# Google Workspace Integration (Calendar, Drive, Meet)
# ===========================================
# Required for Google Calendar sync, Drive file picker, and Meet links.
#
# How to get these:
# 1. Go to https://console.cloud.google.com/projectcreate and create a project
# 2. Enable "Google Calendar API" and "Google Drive API" in the API Library
# 3. Go to Credentials > Create Credentials > OAuth client ID > Web application
# 4. Add authorized redirect URI: https://your-domain.com/api/google/callback
# 5. Copy the Client ID and Client Secret below
#
# For local dev, add redirect URI: http://localhost:3000/api/google/callback
# Don't forget to configure the OAuth consent screen and add test users.

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret

# Secret for verifying Google Calendar push notification webhooks.
# Generate any random string: openssl rand -hex 32
GOOGLE_CALENDAR_WEBHOOK_SECRET=your-random-webhook-secret

# ===========================================
# Email (Resend) Configuration (optional)
# ===========================================
# Required for sending email notifications and transactional emails.
# Sign up at https://resend.com and create an API key.
#
# For development, Resend sends to your own email from onboarding@resend.dev.
# For production, verify your sending domain in the Resend dashboard.

RESEND_API_KEY=re_your-api-key
EMAIL_FROM_ADDRESS=ForgeOS <noreply@yourdomain.com>

# Secret for verifying inbound email webhooks from Resend.
# Generate any random string: openssl rand -hex 32
EMAIL_INBOUND_WEBHOOK_SECRET=your-random-webhook-secret

# ===========================================
# Telegram Bot Configuration
# ===========================================
# Create a bot with @BotFather on Telegram
# 1. Start chat with @BotFather
# 2. Send /newbot and follow instructions
# 3. Copy the token provided

TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_BOT_USERNAME=YourBotName  # Without @ symbol
TELEGRAM_WEBHOOK_SECRET=your-random-secret  # Optional, for webhook verification

# Set webhook URL (run once after deployment):
# curl -X POST "https://api.telegram.org/bot<YOUR_TOKEN>/setWebhook?url=https://your-domain.com/api/bot/telegram&secret_token=<YOUR_WEBHOOK_SECRET>"

# ===========================================
# Cron Jobs
# ===========================================
CRON_SECRET=your-random-cron-secret  # Protects cron endpoints from unauthorized access

# ===========================================
# Push Notifications (optional)
# ===========================================
# VAPID keys for web push notifications
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com

# ===========================================
# Waitlist & Platform Admin
# ===========================================
# Email that receives waitlist signup notifications and can approve/reject
PLATFORM_SUPER_ADMIN_EMAIL=admin@example.com
# Secret for signing one-click approve/reject links in admin emails (use a random string)
WAITLIST_SECRET=your-random-secret-at-least-32-chars

# ===========================================
# Testing Configuration (optional)
# ===========================================
# Set to 'true' to enable test mode features
TEST_MODE=false

# Test user credentials (used by seed scripts)
TEST_USER_PASSWORD=password123

# E2E test credentials (used by Playwright QA walkthroughs)
# Create test accounts in Supabase for each persona
TEST_FOUNDER_EMAIL=
TEST_FOUNDER_PASSWORD=
TEST_EXECUTIVE_EMAIL=
TEST_EXECUTIVE_PASSWORD=
TEST_APPRENTICE_EMAIL=
TEST_APPRENTICE_PASSWORD=
TEST_SUPPLIER_EMAIL=
TEST_SUPPLIER_PASSWORD=
TEST_FREYA_EMAIL=
TEST_FREYA_PASSWORD=

# Optional: override base URL for E2E tests (defaults to http://localhost:3000)
# TEST_URL=https://your-staging-url.vercel.app
