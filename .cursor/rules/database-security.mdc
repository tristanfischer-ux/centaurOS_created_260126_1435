## Secure Query Pattern (Server Actions)

**ALWAYS follow this pattern in src/actions/*.ts files:**

```typescript
'use server'

import { createClient } from '@/lib/supabase/server'
import { getFoundryIdCached } from '@/lib/supabase/utils'

export async function someAction(resourceId: string) {
    const supabase = await createClient()
    const { data: { user } } = await supabase.auth.getUser()
    if (!user) return { error: 'Unauthorized' }
    
    // SECURITY: Get user's foundry_id
    const foundry_id = await getFoundryIdCached()
    if (!foundry_id) return { error: 'User not in a foundry' }
    
    // SECURITY: Fetch resource and verify foundry ownership
    const { data: resource } = await supabase
        .from('tasks')
        .select('foundry_id')
        .eq('id', resourceId)
        .single()
    
    if (!resource) return { error: 'Resource not found' }
    
    // SECURITY: Verify resource belongs to user's foundry
    if (resource.foundry_id !== foundry_id) {
        return { error: 'Unauthorized: Resource belongs to different foundry' }
    }
    
    // ... perform action
}
```

