## Training Examples

### Example 1: Secure Page Component

```typescript
// tasks/page.tsx - CORRECT implementation
export default async function TasksPage() {
    const supabase = await createClient()
    const { data: { user } } = await supabase.auth.getUser()
    if (!user) redirect('/login')
    
    // Step 1: Get foundry_id
    const { data: userProfile } = await supabase
        .from('profiles')
        .select('foundry_id, role')
        .eq('id', user.id)
        .single()
    
    const foundry_id = userProfile?.foundry_id
    if (!foundry_id) return <Error />
    
    // Step 2: Filter ALL queries by foundry_id
    const { data: tasks } = await supabase
        .from('tasks')
        .select('*')
        .eq('foundry_id', foundry_id)  // ✅
    
    const { data: profiles } = await supabase
        .from('profiles')
        .select('*')
        .eq('foundry_id', foundry_id)  // ✅
    
    return <TasksView tasks={tasks} members={profiles} />
}
```

### Example 2: Secure Server Action

```typescript
// actions/tasks.ts - CORRECT implementation
export async function updateTask(taskId: string, updates: Partial<Task>) {
    const supabase = await createClient()
    const { data: { user } } = await supabase.auth.getUser()
    if (!user) return { error: 'Unauthorized' }
    
    // Step 1: Get foundry_id
    const foundry_id = await getFoundryIdCached()
    if (!foundry_id) return { error: 'Not in foundry' }
    
    // Step 2: Fetch resource AND verify foundry
    const { data: task } = await supabase
        .from('tasks')
        .select('foundry_id')
        .eq('id', taskId)
        .single()
    
    if (!task) return { error: 'Not found' }
    
    // Step 3: Verify ownership
    if (task.foundry_id !== foundry_id) {
        return { error: 'Unauthorized: Different foundry' }  // ✅
    }
    
    // Step 4: Perform update (RLS will also enforce)
    const { error } = await supabase
        .from('tasks')
        .update(updates)
        .eq('id', taskId)
    
    return { error }
}
```

