# =============================================================================
# .cursorignore — Exclude files from Cursor's AI indexing and context window
# This directly reduces token consumption and cost on every AI request.
# =============================================================================

# ---- Large binary/data directories (20GB+ of CAD files, zero coding value) --
data/

# ---- Build artifacts and generated output ----------------------------------
.next/
dist/
build/
out/
__pycache__/
.pytest_cache/
.swc/

# ---- Dependencies (auto-excluded but explicit is faster) --------------------
node_modules/
.venv/

# ---- Binary file types (never useful in LLM context) -----------------------
*.stl
*.step
*.f3d
*.dxf
*.DXF
*.pdf
*.pack
*.idx
*.promisor
*.rev
*.zip

# ---- Screenshots and images in root (test artifacts) -----------------------
*.png
*.jpg
*.jpeg
*.gif
*.webp

# ---- Log / output files ----------------------------------------------------
*.log
autoscroll-test.log
console-output.log

# ---- Temp scripts (one-off automation scripts) -----------------------------
capture-audience-final.ts
check-knowledge-page.ts
check-login-button.ts

# ---- Auth / secret artifacts -----------------------------------------------
auth.json

# ---- Agent test reports and deployment summaries (stale artifacts) ---------
# These are past-tense records, not coding context.
*_REPORT.md
*_SUMMARY.md
*_VERIFICATION_REPORT.md
