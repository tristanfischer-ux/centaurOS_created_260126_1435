<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Anvil auto-runner — polls the dossier pipeline every 10 minutes and runs
  the first pass locally (§6.6: Anvil stays on this machine).

  Install:
    cp ops/launchd/com.fractionalforge.anvil-runner.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.fractionalforge.anvil-runner.plist
  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.fractionalforge.anvil-runner.plist

  The runner drains ALL eligible briefs each firing, one at a time (serial —
  two chains fight over CPU). A chain can run for hours; launchd will simply
  skip firings while a run is in progress because the previous instance is
  still alive (no overlap thanks to the atomic status claim in any case).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.fractionalforge.anvil-runner</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>cd "/Users/tristanfischer/Developer/CentaurOS created 260126 1435" &amp;&amp; ANVIL_REPO="/Users/tristanfischer/Developer/CentaurOS-oxccu-efuel" npx tsx scripts/dossier-pipeline/anvil-runner.ts --once</string>
    </array>
    <key>StartInterval</key>
    <integer>600</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/ff-anvil-runner.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/ff-anvil-runner.log</string>
</dict>
</plist>
