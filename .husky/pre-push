#!/bin/sh

echo "🧪 Running pre-push checks..."
echo ""

# Run linter
echo "→ Running lint..."
npm run lint -- --quiet || {
  echo "❌ Lint failed. Fix errors before pushing."
  exit 1
}

# Typecheck against the baseline (Tristan 2026-06-24): the pre-push NEVER ran tsc, so a NEW
# TypeScript error slipped to CI (which runs tsc --noEmit) and turned it red. typecheck:baseline
# fails ONLY on errors beyond the captured baseline (scripts/typecheck-baseline.json) — so it
# blocks NEW type errors here without forcing a clean-up of the long-standing pre-existing debt.
echo "→ Running typecheck (baseline)..."
NODE_OPTIONS="--max-old-space-size=6144" npm run typecheck:baseline || {
  echo "❌ New TypeScript errors vs baseline. Fix them (or, if intentional, npm run typecheck:baseline:update)."
  exit 1
}

# Engine regression guards (Tristan 2026-06-24, CORE FIX PRINCIPLE enforcement): run every
# engine --selftest (the rule-level guards where pricing/sizing/contract source-rule fixes land)
# and BLOCK the push on any failure. This is the DETERMINISTIC enforcement of "every fix carries
# a guard that can't regress" — it must execute, not depend on CLAUDE.md / an agent remembering.
echo "→ Running engine regression guards..."
bash scripts/verify-engine-guards.sh || {
  echo "❌ Engine guards failed — a source rule regressed. Fix the RULE (not the symptom) before pushing."
  exit 1
}

# Run unit tests
echo "→ Running unit tests..."
npm run test || {
  echo "❌ Tests failed. Fix before pushing."
  exit 1
}

echo ""
echo "✅ Pre-push checks passed!"
echo ""
echo "⚠️  REMINDER: CI will run E2E tests."
echo "   If you modified UI, test manually before deploying!"
echo "   See: .cursor/rules/testing-before-deployment.mdc"
